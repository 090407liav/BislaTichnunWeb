<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="WebSIte.master.cs" Inherits="BislaTichnunWeb.WebSIte" %>

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head runat="server">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>מערכת תורנויות ביסל"ט</title>
  <link rel="stylesheet" href="<%= ResolveUrl("~/StyleSheets/WebDesign.css") %>" />
  <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<div class="layout">

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo">ביסל"ט</div>
      <div class="sidebar-sub">תכנון ומיון</div>

        <button type="button" id="sidebarToggle"
        class="sidebar-toggle" title="סגור תפריט">
        ☰
    </button>

    </div>
    <nav class="sidebar-nav">
      <a href="PlanningGantt.aspx" class="nav-item <%= IsActive("PlanningGantt.aspx") %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        לוח תורנויות
      </a>
      <a href="Courses.aspx" class="nav-item <%= IsActive("Courses.aspx") %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        ניהול קורסים
      </a>
      <a href="DutyTypes.aspx" class="nav-item <%= IsActive("DutyTypes.aspx") %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        סוגי תורנויות
      </a>
      <a href="MainDashboard.aspx" class="nav-item <%= IsActive("MainDashboard.aspx") %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        סקירה כללית
      </a>
    </nav>
    <div class="sidebar-footer">משרד תכנון ומיון</div>
  </aside>

  <!-- Main -->
  <main class="main-content">
    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
  </main>

</div>
<script src="<%= ResolveUrl("~/Scripts/WebJScript.js") %>"></script>
<asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>